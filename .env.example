# Alfred configuration. Copy to `.env` and edit.
#
# Every default is free. Nothing in this file needs a paid account, and no
# default points at a metered API. Keys below marked FREE have no billing
# attached and fail with a 429 rather than a charge when the quota runs out.

# ── Reasoning ────────────────────────────────────────────────────────────
# FREE: Google AI Studio -> https://aistudio.google.com/apikey
# Keep this key on a Cloud project with NO billing account attached. Enabling
# billing silently converts the free tier into a paid one.
#
# Privacy note worth reading once: Google's FREE tier may use prompts to improve
# their models; the paid tier does not. Alfred reads your files and mail, so if
# that matters to you, set ALFRED_LLM_PROVIDER=anthropic and supply a paid key.
GEMINI_API_KEY=

# FREE fallback: https://console.groq.com/keys
# Very fast, but only ~6-8k tokens/minute, so the router uses it for short turns
# and avoids it for anything carrying retrieved file context.
GROQ_API_KEY=

# OPTIONAL AND PAID. Leave blank unless you deliberately want to spend money.
ANTHROPIC_API_KEY=

ALFRED_LLM_PROVIDER=gemini
ALFRED_LLM_FALLBACK=true

# ── Who Alfred works for ─────────────────────────────────────────────────
ALFRED_USER_NAME=Jansen
ALFRED_USER_ADDRESS=sir
ALFRED_TIMEZONE=Asia/Manila

# ── Voice ────────────────────────────────────────────────────────────────
# Speech in runs locally on the GPU. Leave the language blank: pinning "en"
# makes Whisper translate Taglish instead of transcribing it.
ALFRED_WHISPER_LANGUAGE=
ALFRED_TRANSCRIPTION_MODE=balanced

# Speech out runs locally too. kokoro = Kokoro-82M (Apache-2.0, free, offline).
# browser = the phone's own speech synthesis, if you would rather not download
# the model. bm_george is Kokoro's British male voice.
ALFRED_TTS_ENGINE=kokoro
ALFRED_TTS_VOICE=bm_george

# ── Reach ────────────────────────────────────────────────────────────────
# 127.0.0.1 serves this laptop only. To reach Alfred from the iPhone, install
# Tailscale on both, then either bind to this machine's 100.x address or (better)
# leave this on loopback and run:
#
#     tailscale serve --bg 8757
#
# which fronts Alfred with a real HTTPS certificate. That is not cosmetic:
# Safari refuses microphone access on plain HTTP, so voice input does not work
# without it.
ALFRED_HOST=127.0.0.1
ALFRED_PORT=8757

# Your machine's MagicDNS name, e.g. my-laptop.tailXXXX.ts.net
# Run `tailscale status --json` or check the admin console to find it.
ALFRED_TAILSCALE_HOSTNAME=

# ── Files Alfred may read ────────────────────────────────────────────────
# Separated by ';' on Windows, ':' elsewhere. Leave blank for the defaults
# (CodingProjects, Documents, Downloads, and the JansenBrain vault).
# Credentials, keys, .git, node_modules and friends are denied inside these
# roots regardless of what you list here.
ALFRED_FILE_ROOTS=

# ── Morning briefing ─────────────────────────────────────────────────────
# Alfred composes a briefing and pushes it to your devices. Times are in
# ALFRED_TIMEZONE. A closed laptop that misses 07:00 still gets the briefing
# when it wakes, within a four-hour grace window.
ALFRED_BRIEFING_ENABLED=true
ALFRED_BRIEFING_HOUR=7
ALFRED_BRIEFING_MINUTE=0

# ── Logging ──────────────────────────────────────────────────────────────
ALFRED_LOG_LEVEL=INFO
# Leave false. True writes your conversations and file excerpts to disk.
ALFRED_LOG_CONVERSATION_CONTENT=false
